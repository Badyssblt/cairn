# Secret de signature des sessions. Générer avec : openssl rand -hex 32
NUXT_SESSION_SECRET=

# Racine des données des serveurs de jeu sur l'hôte.
# Chaque serveur reçoit son propre sous-dossier : <DATA_ROOT>/<id>
NUXT_DATA_ROOT=/srv/gameservers

# Base SQLite du panneau (métadonnées, utilisateurs, échantillons).
NUXT_DB_PATH=./data/minemanager.db

# Socket Docker. En conteneur, monter /var/run/docker.sock au même chemin.
NUXT_DOCKER_SOCKET=/var/run/docker.sock

# La clé API CurseForge ne se met PAS ici : elle se saisit dans /settings
# et vit en base, pour pouvoir la changer sans redéployer.
